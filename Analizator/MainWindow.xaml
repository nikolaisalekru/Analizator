<Window x:Class="Analizator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Analizator"
        Title="Анализатор прохождения КТК"
        Icon="Assets/AppIcon.ico"
        Width="1180" Height="760" MinWidth="980" MinHeight="650"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <Grid Background="{StaticResource WindowBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Margin="24,28,20,25">
                    <Border Width="48" Height="48" HorizontalAlignment="Left"
                            Background="Transparent" CornerRadius="10">
                        <Image Source="Assets/AppIcon.png" Stretch="Uniform" />
                    </Border>
                    <TextBlock Text="АНАЛИЗАТОР" Foreground="White" FontSize="17"
                               FontWeight="SemiBold" Margin="0,13,0,0" />
                    <TextBlock Text="Прохождение КТК" Foreground="#91A4C1" FontSize="12" />
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <Button x:Name="DashboardNavButton" Content="▣   Обработка"
                            Style="{StaticResource NavButtonStyle}"
                            Background="{StaticResource SidebarHoverBrush}"
                            Click="DashboardNavButton_Click" />
                    <Button x:Name="DatabaseNavButton" Content="▤   База данных"
                            Style="{StaticResource NavButtonStyle}"
                            Click="DatabaseNavButton_Click" />
                    <Button x:Name="StatisticsNavButton" Content="▥   Статистика"
                            Style="{StaticResource NavButtonStyle}"
                            Click="StatisticsNavButton_Click" />
                    <Button x:Name="MonitoringNavButton" Content="▦   Мониторинг"
                            Style="{StaticResource NavButtonStyle}"
                            Click="MonitoringNavButton_Click" />
                    <Button x:Name="PdfPhotoNavButton" Content="▤   Фото в PDF"
                            Style="{StaticResource NavButtonStyle}"
                            Click="PdfPhotoNavButton_Click" />
                    <Button x:Name="SettingsNavButton" Content="⚙   Настройки"
                            Style="{StaticResource NavButtonStyle}"
                            Click="SettingsNavButton_Click" />
                    <Button x:Name="LogsNavButton" Content="≡   Журналы"
                            Style="{StaticResource NavButtonStyle}"
                            Click="LogsNavButton_Click" />
                </StackPanel>
                <Border Grid.Row="2" Margin="16,0,16,20" Padding="14"
                        Background="#1C2D48" CornerRadius="9">
                    <StackPanel>
                        <TextBlock Text="Состояние" Foreground="White" FontWeight="SemiBold" />
                        <TextBlock x:Name="SidebarStatusText" Text="Проверка встроенного ядра…"
                                   Foreground="#91A4C1" FontSize="11" Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>

            <ScrollViewer x:Name="DashboardView" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="34,28,34,32">
                    <DockPanel Margin="0,0,0,22">
                        <StackPanel>
                            <TextBlock Text="Новая обработка" FontSize="28" FontWeight="SemiBold" />
                            <TextBlock Text="Подготовьте исходные файлы и запустите анализ"
                                       Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
                        </StackPanel>
                        <Border x:Name="SystemStatusBadge" DockPanel.Dock="Right"
                                Padding="12,7" Background="#FFF4E5"
                                CornerRadius="18" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock x:Name="SystemStatusText" Text="●  Проверка системы…"
                                       Foreground="#A15C00"
                                       FontSize="12" FontWeight="SemiBold" />
                        </Border>
                    </DockPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="280" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,18">
                                        <StackPanel>
                                            <TextBlock Text="Исходные данные" FontSize="18" FontWeight="SemiBold" />
                                            <TextBlock x:Name="AnalysisSourceDescriptionText"
                                                       Text="Шаблон анализа и Excel-выгрузка"
                                                       Foreground="{StaticResource MutedTextBrush}" />
                                        </StackPanel>
                                        <CheckBox x:Name="AutoSelectCheckBox" DockPanel.Dock="Right"
                                                  Content="Автовыбор из input" IsChecked="True"
                                                  Checked="AutoSelectCheckBox_Changed"
                                                  Unchecked="AutoSelectCheckBox_Changed" />
                                    </DockPanel>
                                    <TextBlock Text="Источник результатов КТК" FontWeight="SemiBold"
                                               Margin="0,0,0,7" />
                                    <ComboBox x:Name="AnalysisSourceComboBox" Height="35" SelectedIndex="0"
                                              SelectionChanged="AnalysisSourceComboBox_SelectionChanged">
                                        <ComboBoxItem Content="Excel-выгрузка" />
                                        <ComboBoxItem Content="База данных" />
                                    </ComboBox>
                                    <TextBlock Text="Таблица анализа" FontWeight="SemiBold" Margin="0,17,0,7" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="105" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="AnalysisFileTextBox" IsReadOnly="True" />
                                        <Button Grid.Column="2" Content="Выбрать…" Click="BrowseAnalysisButton_Click"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                    </Grid>
                                    <StackPanel x:Name="ExcelSourcePanel">
                                        <TextBlock Text="Выгрузка КТК" FontWeight="SemiBold" Margin="0,17,0,7" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="105" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="ExportFileTextBox" IsReadOnly="True" />
                                            <Button Grid.Column="2" Content="Выбрать…" Click="BrowseExportButton_Click"
                                                    Style="{StaticResource SecondaryButtonStyle}" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel x:Name="DatabaseSourcePanel" Visibility="Collapsed">
                                        <TextBlock Text="Месяц из базы данных" FontWeight="SemiBold"
                                                   Margin="0,17,0,7" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="105" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="DatabaseMonthComboBox" Height="35"
                                                      DisplayMemberPath="Display"
                                                      SelectionChanged="DatabaseMonthComboBox_SelectionChanged" />
                                            <Button Grid.Column="2" Content="Обновить"
                                                    Click="RefreshDatabaseMonthsButton_Click"
                                                    Style="{StaticResource SecondaryButtonStyle}" />
                                        </Grid>
                                        <TextBlock x:Name="DatabaseMonthDetailsText"
                                                   Text="В базе пока нет доступных месяцев"
                                                   Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                                   Margin="1,6,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Text="Папка результата" FontWeight="SemiBold" Margin="0,17,0,7" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="105" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="OutputFolderTextBox"
                                                 TextChanged="OutputFolderTextBox_TextChanged" />
                                        <Button Grid.Column="2" Content="Открыть" Click="OpenOutputFolderButton_Click"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                                <StackPanel>
                                    <TextBlock Text="Ход выполнения" FontSize="18" FontWeight="SemiBold" />
                                    <DockPanel Margin="0,4,0,12" LastChildFill="False">
                                        <TextBlock x:Name="ProgressStageText" Text="Ожидание запуска"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock x:Name="ProgressPercentText" DockPanel.Dock="Right"
                                                   Text="0%" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentBrush}" />
                                    </DockPanel>
                                    <ProgressBar x:Name="ProcessingProgressBar" Height="10"
                                                 Maximum="100" Foreground="{StaticResource AccentBrush}"
                                                 Background="#E9EEF6" />
                                    <DockPanel Margin="0,18,0,0">
                                        <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Отменить"
                                                Width="105" IsEnabled="False" Click="CancelButton_Click"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button x:Name="StartButton" DockPanel.Dock="Right" Content="Запустить анализ"
                                                Width="170" Margin="0,0,10,0" Click="StartButton_Click"
                                                Style="{StaticResource PrimaryButtonStyle}" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Параметры" FontSize="18" FontWeight="SemiBold"
                                               Margin="0,0,0,15" />
                                    <CheckBox x:Name="CreateBackupCheckBox" Content="Создать копию таблицы анализа"
                                              IsChecked="True" Margin="0,0,0,13" />
                                    <CheckBox x:Name="AutoAddPeopleCheckBox" Content="Добавлять новых сотрудников"
                                              IsChecked="True" Margin="0,0,0,13" />
                                    <CheckBox x:Name="OpenResultCheckBox" Content="Открыть результат после обработки"
                                              IsChecked="True" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                                <StackPanel>
                                    <TextBlock Text="Быстрые действия" FontSize="18" FontWeight="SemiBold"
                                               Margin="0,0,0,13" />
                                    <Button Content="Обновить найденные файлы" Margin="0,0,0,8"
                                            Click="RefreshFilesButton_Click"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button Content="Открыть папку input" Margin="0,0,0,8"
                                            Click="OpenInputFolderButton_Click"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button Content="Открыть последний лог"
                                            Click="OpenLatestLogButton_Click"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                                <StackPanel>
                                    <TextBlock Text="Последний запуск" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock x:Name="LastRunText" Text="Ещё не запускался"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Margin="0,5,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="DatabaseView" Visibility="Collapsed" Margin="34,28,34,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Единая база данных" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="Загрузка выгрузок за несколько месяцев и хранение истории"
                                   Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                Margin="0,14,0,0">
                        <Button x:Name="ExportDatabaseSelectionButton" Content="Сформировать выгрузку…"
                                Width="205" Margin="0,0,9,0"
                                Click="ExportDatabaseSelectionButton_Click"
                                Style="{StaticResource PrimaryButtonStyle}" />
                        <Button x:Name="EditDatabaseRecordsButton" Content="Редактировать записи" Width="165"
                                Margin="0,0,9,0" Click="EditDatabaseRecordsButton_Click"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Content="Обновить" Width="100" Margin="0,0,9,0"
                                Click="RefreshDatabaseButton_Click"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Content="Открыть папку" Width="130"
                                Click="OpenDatabaseFolderButton_Click"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="0,0,7,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Попыток" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock x:Name="DatabaseAttemptsText" Text="0" FontSize="25"
                                               FontWeight="SemiBold" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Сотрудников" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock x:Name="DatabasePeopleText" Text="0" FontSize="25"
                                               FontWeight="SemiBold" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Файлов" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock x:Name="DatabaseFilesCountText" Text="0" FontSize="25"
                                               FontWeight="SemiBold" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="6" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Период" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock x:Name="DatabasePeriodText" Text="—" FontSize="16"
                                               FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border x:Name="DatabaseDuplicateBorder" Margin="0,14,0,0" Padding="16,12"
                                Background="#E8F6EF" BorderBrush="#BCE4D0" BorderThickness="1"
                                CornerRadius="9">
                            <TextBlock x:Name="DatabaseDuplicateText"
                                       Foreground="#16764D" TextWrapping="Wrap" />
                        </Border>

                        <Border x:Name="DatabaseInstallationWarningBorder" Margin="0,10,0,0" Padding="16,12"
                                Background="#FFF4E5" BorderBrush="#F2CF94" BorderThickness="1"
                                CornerRadius="9" Visibility="Collapsed">
                            <TextBlock x:Name="DatabaseInstallationWarningText"
                                       Foreground="#A15C00" TextWrapping="Wrap" />
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DockPanel>
                                    <StackPanel>
                                        <TextBlock Text="Добавить выгрузки" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="Можно выбрать сразу несколько файлов Excel и JSON, в том числе за разные месяцы"
                                                   Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button x:Name="SelectDatabaseFilesButton" Content="Выбрать файлы…"
                                                Width="135" Margin="0,0,9,0"
                                                Click="SelectDatabaseFilesButton_Click"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button x:Name="ClearDatabaseFilesButton" Content="Очистить"
                                                Width="95" Click="ClearDatabaseFilesButton_Click"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                    </StackPanel>
                                </DockPanel>
                                <ListBox x:Name="DatabaseFilesListBox" Grid.Row="1" Height="105"
                                         Margin="0,15,0,0" DisplayMemberPath="Name"
                                         BorderBrush="{StaticResource BorderBrush}" />
                                <Grid Grid.Row="2" Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="9" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ProgressBar x:Name="DatabaseImportProgressBar" Height="10"
                                                 Maximum="100" VerticalAlignment="Center"
                                                 Foreground="{StaticResource AccentBrush}" Background="#E9EEF6" />
                                    <Button x:Name="CancelDatabaseImportButton" Grid.Column="2"
                                            Content="Отменить" Width="100" IsEnabled="False"
                                            Click="CancelDatabaseImportButton_Click"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button x:Name="ImportDatabaseFilesButton" Grid.Column="4"
                                            Content="Загрузить в базу" Width="155"
                                            Click="ImportDatabaseFilesButton_Click"
                                            Style="{StaticResource PrimaryButtonStyle}" />
                                </Grid>
                                <TextBlock x:Name="DatabaseImportStatusText" Grid.Row="3"
                                           Text="Выберите одну или несколько выгрузок"
                                           Foreground="{StaticResource MutedTextBrush}" Margin="0,9,0,0"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DockPanel>
                                    <StackPanel>
                                        <TextBlock Text="Загруженные файлы" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock x:Name="DatabasePathText" Text="Путь к базе"
                                                   Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                                   Margin="0,3,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button x:Name="DeleteDatabaseSourceButton" DockPanel.Dock="Right"
                                            Content="Удалить выбранный" Width="155"
                                            Click="DeleteDatabaseSourceButton_Click"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                </DockPanel>
                                <DataGrid x:Name="DatabaseHistoryDataGrid" Grid.Row="1" Height="270"
                                          Margin="0,15,0,0" AutoGenerateColumns="False" IsReadOnly="True"
                                          CanUserAddRows="False" CanUserDeleteRows="False"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                          BorderBrush="{StaticResource BorderBrush}" SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Файл" Binding="{Binding FileName}" Width="*" />
                                        <DataGridTextColumn Header="Формат" Binding="{Binding FormatDisplay}" Width="95" />
                                        <DataGridTextColumn Header="Период" Binding="{Binding PeriodDisplay}" Width="190" />
                                        <DataGridTextColumn Header="Строк" Binding="{Binding RowsCount}" Width="75" />
                                        <DataGridTextColumn Header="Замечаний" Binding="{Binding ErrorCount}" Width="90" />
                                        <DataGridTextColumn Header="Загружен" Binding="{Binding ImportedAtDisplay}" Width="135" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="SettingsView" Visibility="Collapsed" Margin="34,28,34,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="Настройки" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="Пути программы, порог прохождения, резервные копии и конфигурации"
                               Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
                </StackPanel>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,7,0">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Встроенное ядро" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="Среда выполнения" FontWeight="SemiBold"
                                           Margin="0,12,0,5" />
                                <TextBox x:Name="RuntimeTextBox" TextWrapping="Wrap" />
                                <TextBlock Text="Рабочая папка данных" FontWeight="SemiBold"
                                           Margin="0,12,0,5" />
                                <TextBox x:Name="EngineFolderTextBox" Margin="0,0,0,10" TextWrapping="Wrap" />
                                <Button Content="Применить путь" Click="ApplyEngineFolderButton_Click"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="Порог прохождения" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock x:Name="PassingThresholdSummaryText" Text="Загрузка настройки…"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Margin="0,5,0,12" TextWrapping="Wrap" />
                                <Button Content="Настроить пороги…"
                                        Click="EditPassingThresholdButton_Click"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="Резервные копии базы" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock x:Name="DatabaseBackupSummaryText" Text="Загрузка настройки…"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Margin="0,5,0,12" TextWrapping="Wrap" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="Настроить…" Click="EditDatabaseBackupSettingsButton_Click"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button Grid.Column="2" Content="Создать сейчас"
                                            Click="CreateDatabaseBackupNowButton_Click"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="Конфигурации" FontSize="17" FontWeight="SemiBold"
                                           Margin="0,0,0,12" />
                                <ListBox x:Name="ConfigFilesListBox" Height="180" BorderThickness="0"
                                         SelectionChanged="ConfigFilesListBox_SelectionChanged" />
                                <Button Content="Открыть папку configs" Margin="0,12,0,0"
                                        Click="OpenConfigFolderButton_Click"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <local:ConfigurationEditor x:Name="ConfigEditor" Saved="ConfigEditor_Saved" />
                    </Border>
                </Grid>
            </Grid>

            <Grid x:Name="LogsView" Visibility="Collapsed" Margin="34,28,34,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <StackPanel>
                        <TextBlock Text="Журналы обработки" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="Консольный вывод и техническая диагностика"
                                   Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Обновить" Width="100" Margin="0,0,9,0"
                                Click="RefreshLogsButton_Click"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Content="Открыть папку" Width="125"
                                Click="OpenLogsFolderButton_Click"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </StackPanel>
                </DockPanel>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="290" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBox x:Name="LogSearchTextBox" ToolTip="Поиск по имени"
                                     TextChanged="LogSearchTextBox_TextChanged" />
                            <ListBox x:Name="LogsListBox" Grid.Row="1" Margin="0,14,0,0"
                                     BorderThickness="0" DisplayMemberPath="Name"
                                     SelectionChanged="LogsListBox_SelectionChanged" />
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock x:Name="LogTitleText" Text="Выберите журнал"
                                               FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock x:Name="LogMetaText" FontSize="11"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                                <Button x:Name="OpenLogExternalButton" DockPanel.Dock="Right"
                                        Content="Открыть в Блокноте" Width="145" IsEnabled="False"
                                        Click="OpenLogExternalButton_Click"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                            </DockPanel>
                            <TextBox x:Name="LogContentTextBox" Grid.Row="1" IsReadOnly="True"
                                     FontFamily="Consolas" FontSize="12" AcceptsReturn="True"
                                     TextWrapping="NoWrap" VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     Background="#101826" Foreground="#D8E2F0"
                                     BorderThickness="0" Padding="16" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <DockPanel Margin="14,0" LastChildFill="False">
                    <TextBlock x:Name="FooterStatusText" Text="Готово" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                    <TextBlock DockPanel.Dock="Right" Text="Analizator · C# / .NET 8"
                               VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
