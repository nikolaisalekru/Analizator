<Window x:Class="Analizator.DatabaseAttemptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Запись базы данных" Icon="Assets/AppIcon.ico"
        Width="650" Height="720" MinWidth="570" MinHeight="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="HeadingText" Text="Запись попытки" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Обязательные поля отмечены звёздочкой"
                       Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18,0,18">
            <Border Style="{StaticResource CardStyle}" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Дата *" FontSize="12" Margin="1,0,0,4" />
                        <DatePicker x:Name="AttemptDatePicker" Height="36" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Время *" FontSize="12" Margin="1,0,0,4" />
                        <TextBox x:Name="AttemptTimeTextBox" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.ColumnSpan="3">
                        <TextBlock Text="Установка *" FontSize="12" Margin="1,0,0,4" />
                        <ComboBox x:Name="InstallationComboBox" IsEditable="True" Height="36"
                                  IsTextSearchEnabled="True" />
                    </StackPanel>

                    <StackPanel Grid.Row="4" Grid.ColumnSpan="3">
                        <TextBlock Text="ФИО *" FontSize="12" Margin="1,0,0,4" />
                        <TextBox x:Name="PersonNameTextBox" />
                    </StackPanel>

                    <StackPanel Grid.Row="6" Grid.ColumnSpan="3">
                        <TextBlock Text="Сценарий *" FontSize="12" Margin="1,0,0,4" />
                        <TextBox x:Name="ScenarioTextBox" />
                    </StackPanel>

                    <StackPanel Grid.Row="8">
                        <TextBlock Text="Процент *" FontSize="12" Margin="1,0,0,4" />
                        <TextBox x:Name="PercentTextBox" />
                    </StackPanel>
                    <StackPanel Grid.Row="8" Grid.Column="2">
                        <TextBlock Text="Количество действий" FontSize="12" Margin="1,0,0,4" />
                        <TextBox x:Name="ActionsTextBox" />
                    </StackPanel>

                    <StackPanel Grid.Row="10">
                        <TextBlock Text="Режим" FontSize="12" Margin="1,0,0,4" />
                        <TextBox x:Name="ModeTextBox" />
                    </StackPanel>
                    <StackPanel Grid.Row="10" Grid.Column="2">
                        <TextBlock Text="Проект" FontSize="12" Margin="1,0,0,4" />
                        <TextBox x:Name="ProjectTextBox" />
                    </StackPanel>

                    <Grid Grid.Row="12" Grid.ColumnSpan="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Должность" FontSize="12" Margin="1,0,0,4" />
                            <TextBox x:Name="RoleTextBox" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Зачтено" FontSize="12" Margin="1,0,0,4" />
                            <TextBox x:Name="CreditedTextBox" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Длительность" FontSize="12" Margin="1,0,0,4" />
                            <TextBox x:Name="DurationTextBox" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" Width="105" Margin="0,0,10,0" IsCancel="True"
                    Style="{StaticResource SecondaryButtonStyle}" />
            <Button Content="Сохранить" Width="125" Click="SaveButton_Click"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
