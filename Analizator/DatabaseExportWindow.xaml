<Window x:Class="Analizator.DatabaseExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выгрузка из базы данных"
        Icon="Assets/AppIcon.ico"
        Width="1160" Height="790" MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterOwner" Closing="Window_Closing">
    <Grid Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="White" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="28,22">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="46" Height="46" CornerRadius="12"
                        Background="#EAF0FF" Margin="0,0,15,0">
                    <TextBlock Text="⇩" Foreground="{StaticResource AccentBrush}"
                               FontSize="23" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel>
                    <TextBlock Text="Выгрузка из базы данных" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock Text="Выберите месяц или диапазон, листы установок и столбцы Excel"
                               Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid x:Name="SelectionWorkspace" Grid.Row="1" Margin="24,18,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource CardStyle}" Padding="20,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <WrapPanel VerticalAlignment="Center">
                        <RadioButton x:Name="MonthPeriodRadioButton" Content="Месяц"
                                     IsChecked="True" Margin="0,0,10,0" VerticalAlignment="Center"
                                     Click="PeriodModeButton_Click" />
                        <ComboBox x:Name="MonthComboBox" Width="245" Height="35" Margin="0,0,24,0"
                                  DisplayMemberPath="Display" VerticalContentAlignment="Center"
                                  SelectionChanged="MonthComboBox_SelectionChanged" />
                        <RadioButton x:Name="RangePeriodRadioButton" Content="Диапазон"
                                     Margin="0,0,10,0" VerticalAlignment="Center"
                                     Click="PeriodModeButton_Click" />
                        <DatePicker x:Name="StartDatePicker" Width="145" Height="35"
                                    VerticalContentAlignment="Center" />
                        <TextBlock Text="—" Margin="9,0" Foreground="{StaticResource MutedTextBrush}"
                                   VerticalAlignment="Center" />
                        <DatePicker x:Name="EndDatePicker" Width="145" Height="35" Margin="0,0,18,0"
                                    VerticalContentAlignment="Center" />
                        <Button x:Name="RefreshPeopleButton" Content="Обновить список"
                                Width="145" Click="RefreshPeopleButton_Click"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </WrapPanel>
                    <TextBlock x:Name="PeriodSummaryText" Grid.Row="1" Margin="0,11,0,0"
                               Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="235" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="240" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Установки" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" Text="Каждая отмеченная установка станет отдельным листом"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,4,0,12" />
                        <ListBox x:Name="InstallationsListBox" Grid.Row="2"
                                 BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Click="InstallationCheckBox_Click"
                                              Margin="1,5" ToolTip="{Binding Name}">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                   MaxWidth="175" />
                                    </CheckBox>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Все" Width="82" Margin="0,0,8,0"
                                    Click="SelectAllInstallationsButton_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Content="Снять" Width="82" Click="ClearInstallationsButton_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <StackPanel>
                                <TextBlock Text="Сотрудники" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="Необязательно: без выбора попадут все сотрудники"
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="VisiblePeopleText" DockPanel.Dock="Right"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBox x:Name="PeopleSearchTextBox" Grid.Row="1" Margin="0,13,0,0"
                                 ToolTip="Поиск работает по любой части ФИО"
                                 TextChanged="PeopleSearchTextBox_TextChanged" />
                        <TextBlock Grid.Row="1" Margin="12,13,0,0" IsHitTestVisible="False"
                                   VerticalAlignment="Center" Foreground="#9AA7B8"
                                   Text="Поиск по ФИО…">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=PeopleSearchTextBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <DataGrid x:Name="PeopleDataGrid" Grid.Row="3" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                                  IsReadOnly="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  BorderBrush="{StaticResource BorderBrush}" SelectionMode="Extended"
                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="42">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center"
                                                      Click="PersonCheckBox_Click" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="ФИО" Binding="{Binding PersonName}"
                                                    Width="*" IsReadOnly="True" />
                                <DataGridTextColumn Header="Установка" Binding="{Binding Installation}"
                                                    Width="145" IsReadOnly="True" />
                                <DataGridTextColumn Header="Записей" Binding="{Binding Attempts}"
                                                    Width="72" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Выбрать найденных" Width="150" Margin="0,0,8,0"
                                    Click="SelectVisiblePeopleButton_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Content="Снять выбор" Width="115"
                                    Click="ClearPeopleButton_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Столбцы Excel" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" Text="Отметьте только нужные поля; порядок сохраняется"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,4,0,12" />
                        <ListBox x:Name="ColumnsListBox" Grid.Row="2" BorderThickness="0"
                                 Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              IsEnabled="{Binding CanChange}" Margin="1,5"
                                              Click="ColumnCheckBox_Click">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" />
                                            <TextBlock Text="{Binding Note}" FontSize="10"
                                                       Foreground="{StaticResource MutedTextBrush}" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border Grid.Row="3" Background="#F7F9FC" CornerRadius="8" Padding="11,9"
                                Margin="0,12,0,0">
                            <TextBlock Text="Точные повторы не попадут в файл. Возможные повторы сохраняются для проверки."
                                       FontSize="10" Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="SelectionSummaryText" FontWeight="SemiBold"
                               Text="Все сотрудники выбранных установок" />
                    <TextBlock x:Name="ExportStatusText" Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11" Margin="0,3,0,0" />
                    <ProgressBar x:Name="ExportProgressBar" Height="3" Margin="0,7,30,0"
                                 IsIndeterminate="True" Visibility="Collapsed"
                                 Foreground="{StaticResource AccentBrush}" />
                </StackPanel>
                <Button x:Name="CancelButton" Grid.Column="1" Content="Отмена" Width="105" Click="CancelButton_Click"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <Button x:Name="ExportButton" Grid.Column="3" Content="Сформировать Excel" Width="180"
                        Click="ExportButton_Click" IsEnabled="False"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </Grid>
        </Border>
    </Grid>
</Window>
