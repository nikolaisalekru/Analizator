<Window x:Class="Analizator.PassingThresholdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Порог прохождения КТК"
        Icon="Assets/AppIcon.ico"
        Width="680" Height="700" MinWidth="560" MinHeight="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Порог прохождения" FontSize="25" FontWeight="SemiBold" />
            <TextBlock Text="Значение, равное порогу, считается проходным. Допустимый диапазон: от 0 до 100%."
                       Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,20,0,16">
            <StackPanel>
                <CheckBox x:Name="UsePerInstallationCheckBox"
                          Content="Использовать отдельный порог для каждой установки"
                          FontWeight="SemiBold"
                          Checked="ThresholdMode_Changed" Unchecked="ThresholdMode_Changed" />
                <Grid Margin="0,17,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="115" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Единый порог" FontWeight="SemiBold" />
                        <TextBlock Text="Применяется ко всем установкам, когда флаг выключен"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                    </StackPanel>
                    <TextBox x:Name="GlobalThresholdTextBox" Grid.Column="1"
                             HorizontalContentAlignment="Right" VerticalContentAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="18,15,18,12" LastChildFill="False">
                    <TextBlock Text="Индивидуальные значения" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock DockPanel.Dock="Right" Text="проценты"
                               Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                </DockPanel>
                <DataGrid x:Name="ThresholdDataGrid" Grid.Row="1"
                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserReorderColumns="False" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" BorderThickness="0"
                          RowHeaderWidth="0" AlternatingRowBackground="#F7F9FC">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Установка" Binding="{Binding Installation}"
                                            IsReadOnly="True" Width="*" />
                        <DataGridTextColumn Header="Порог, %"
                                            Binding="{Binding ThresholdText, UpdateSourceTrigger=PropertyChanged}"
                                            Width="125" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ValidationStatusText" Foreground="#B42318"
                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Отмена" Width="105" IsCancel="True"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <Button Content="Сохранить" Width="120" Margin="10,0,0,0"
                        Click="SaveButton_Click" Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
