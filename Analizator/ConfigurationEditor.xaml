<UserControl x:Class="Analizator.ConfigurationEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock x:Name="TitleText" Text="Выберите конфигурацию"
                       FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="PathText" FontSize="11"
                       Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1">
            <TextBlock x:Name="EmptyText" Text="Выберите раздел слева"
                       Foreground="{StaticResource MutedTextBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />

            <Grid x:Name="InstallationsPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Установка" FontWeight="SemiBold" Margin="0,0,0,6" />
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="9" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="InstallationsComboBox" Height="36"
                              SelectionChanged="InstallationsComboBox_SelectionChanged" />
                    <Button Grid.Column="2" Content="Удалить установку" Width="145"
                            Click="DeleteInstallationButton_Click"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </Grid>
                <Grid Grid.Row="2" Margin="0,10,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="9" />
                        <ColumnDefinition Width="125" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NewInstallationTextBox" ToolTip="Название новой установки" />
                    <Button Grid.Column="2" Content="Добавить"
                            Click="AddInstallationButton_Click"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </Grid>
                <TextBlock Grid.Row="3" Text="Известные синонимы" FontWeight="SemiBold"
                           Margin="0,0,0,6" VerticalAlignment="Top" />
                <ListBox x:Name="InstallationAliasesListBox" Grid.Row="3" Margin="0,26,0,0"
                         BorderBrush="{StaticResource BorderBrush}" />
                <Grid Grid.Row="4" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="9" />
                        <ColumnDefinition Width="105" />
                        <ColumnDefinition Width="9" />
                        <ColumnDefinition Width="105" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NewAliasTextBox" ToolTip="Новый синоним"
                             KeyDown="NewAliasTextBox_KeyDown" />
                    <Button Grid.Column="2" Content="Добавить" Click="AddAliasButton_Click"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Grid.Column="4" Content="Удалить" Click="DeleteAliasButton_Click"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </Grid>
            </Grid>

            <Grid x:Name="SettingsPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Основные параметры анализа" FontSize="16" FontWeight="SemiBold"
                           Margin="0,0,0,15" />
                <CheckBox x:Name="ParallelProcessingCheckBox" Grid.Row="1"
                          Content="Параллельная обработка файлов" Margin="0,0,0,14" />
                <CheckBox x:Name="AutoAddPeopleDefaultCheckBox" Grid.Row="2"
                          Content="По умолчанию добавлять новых сотрудников" Margin="0,0,0,14" />
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Параллельных обработчиков" VerticalAlignment="Center" />
                    <TextBox x:Name="MaximumWorkersTextBox" Grid.Column="1" />
                </Grid>
                <Border Grid.Row="4" Margin="0,22,0,0" Padding="14"
                        Background="#F7F9FC" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" VerticalAlignment="Top">
                    <TextBlock Text="Порог прохождения и резервные копии настраиваются отдельными блоками слева. Их значения при сохранении останутся без изменений."
                               Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                </Border>
            </Grid>

            <Grid x:Name="FioKeysPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Раздел (установка)" FontWeight="SemiBold" Margin="0,0,0,6" />
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="9" />
                        <ColumnDefinition Width="135" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="FioSectionsComboBox" Height="36"
                              SelectionChanged="FioSectionsComboBox_SelectionChanged" />
                    <Button Grid.Column="2" Content="Удалить раздел"
                            Click="DeleteFioSectionButton_Click"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </Grid>
                <Grid Grid.Row="2" Margin="0,10,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="9" />
                        <ColumnDefinition Width="125" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NewFioSectionTextBox" ToolTip="Название нового раздела" />
                    <Button Grid.Column="2" Content="Добавить раздел"
                            Click="AddFioSectionButton_Click"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </Grid>
                <DataGrid x:Name="FioKeysDataGrid" Grid.Row="3" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          BorderBrush="{StaticResource BorderBrush}" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Сокращение" Binding="{Binding Abbreviation}" Width="*" />
                        <DataGridTextColumn Header="Полное ФИО" Binding="{Binding FullName}" Width="1.4*" />
                    </DataGrid.Columns>
                </DataGrid>
                <Grid Grid.Row="4" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="9" />
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition Width="9" />
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="9" />
                        <ColumnDefinition Width="92" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NewAbbreviationTextBox" ToolTip="Сокращение ФИО" />
                    <TextBox x:Name="NewFullNameTextBox" Grid.Column="2" ToolTip="Полное ФИО" />
                    <Button Grid.Column="4" Content="Добавить" Click="AddFioKeyButton_Click"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Grid.Column="6" Content="Удалить" Click="DeleteFioKeyButton_Click"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </Grid>
            </Grid>

            <Grid x:Name="ExcludedPeoplePanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Исключённые имена и служебные обозначения"
                           FontWeight="SemiBold" Margin="0,0,0,8" />
                <ListBox x:Name="ExcludedPeopleListBox" Grid.Row="1"
                         BorderBrush="{StaticResource BorderBrush}" />
                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="9" />
                        <ColumnDefinition Width="105" />
                        <ColumnDefinition Width="9" />
                        <ColumnDefinition Width="105" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NewExcludedPersonTextBox" ToolTip="ФИО или обозначение"
                             KeyDown="NewExcludedPersonTextBox_KeyDown" />
                    <Button Grid.Column="2" Content="Добавить" Click="AddExcludedPersonButton_Click"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Grid.Column="4" Content="Удалить" Click="DeleteExcludedPersonButton_Click"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </Grid>
            </Grid>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText" Text="Выберите раздел слева"
                       Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"
                       TextWrapping="Wrap" />
            <Button x:Name="ReloadButton" DockPanel.Dock="Right" Content="Перечитать"
                    Width="105" Margin="9,0,9,0" IsEnabled="False"
                    Click="ReloadButton_Click" Style="{StaticResource SecondaryButtonStyle}" />
            <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="Сохранить"
                    Width="110" IsEnabled="False" Click="SaveButton_Click"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </DockPanel>
    </Grid>
</UserControl>
