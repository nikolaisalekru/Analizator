<Window x:Class="Analizator.MonitoringReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Мониторинг КТК" Icon="Assets/AppIcon.ico"
        Width="900" Height="700" MinWidth="780" MinHeight="620"
        WindowStartupLocation="CenterOwner" Closing="Window_Closing">
    <Grid Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="28,22">
            <DockPanel>
                <Border Width="46" Height="46" CornerRadius="12" Background="#EAF0FF" Margin="0,0,15,0">
                    <TextBlock Text="▦" Foreground="{StaticResource AccentBrush}" FontSize="22" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="Мониторинг КТК" FontSize="25" FontWeight="SemiBold"/>
                    <TextBlock Text="Квартальные показатели и заполненная форма сбора" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,18,24,24">
                <Border Style="{StaticResource CardStyle}" Padding="20,17">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="155"/><ColumnDefinition Width="16"/><ColumnDefinition Width="155"/><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Дата начала" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/><DatePicker x:Name="StartDatePicker" Height="35" Margin="0,4,0,0"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Дата окончания" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/><DatePicker x:Name="EndDatePicker" Height="35" Margin="0,4,0,0"/></StackPanel>
                        <TextBlock x:Name="ScopeSummaryText" Grid.Column="3" Foreground="{StaticResource MutedTextBrush}" TextAlignment="Right" VerticalAlignment="Center" Margin="18,0" TextWrapping="Wrap"/>
                        <Button x:Name="RefreshScopeButton" Grid.Column="4" Content="Обновить" Click="RefreshScopeButton_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                    </Grid>
                </Border>
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardStyle}" Padding="20">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="250"/></Grid.RowDefinitions>
                            <DockPanel>
                                <StackPanel><TextBlock Text="Установки" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Технические объекты для расчёта" Foreground="{StaticResource MutedTextBrush}"/></StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="SelectAllButton" Content="Все" Width="70" Margin="0,0,8,0" Click="SelectAllButton_Click" Style="{StaticResource SecondaryButtonStyle}"/><Button x:Name="ClearButton" Content="Снять" Width="70" Click="ClearButton_Click" Style="{StaticResource SecondaryButtonStyle}"/></StackPanel>
                            </DockPanel>
                            <ListBox x:Name="InstallationsListBox" Grid.Row="1" Margin="0,14,0,0" BorderBrush="{StaticResource BorderBrush}">
                                <ListBox.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Click="InstallationCheckBox_Click" Margin="8,6"><DockPanel Width="390"><TextBlock Text="{Binding Summary}" DockPanel.Dock="Right" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></DockPanel></CheckBox></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Форма сбора" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Шаблон Excel" Foreground="{StaticResource MutedTextBrush}" Margin="0,14,0,4"/>
                            <TextBox x:Name="TemplatePathTextBox" Height="56" IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Center"/>
                            <Button x:Name="BrowseTemplateButton" Content="Выбрать шаблон" Margin="0,8,0,0" Click="BrowseTemplateButton_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                            <CheckBox x:Name="IncludePossibleDuplicatesCheckBox" Content="Учитывать возможные повторы" IsChecked="True" Margin="0,18,0,0"/>
                            <CheckBox x:Name="OpenResultsCheckBox" Content="Открыть оба файла" IsChecked="True" Margin="0,10,0,0"/>
                            <Border Background="#F7F9FC" CornerRadius="8" Padding="12,10" Margin="0,18,0,0"><TextBlock Text="Будут созданы подробный отчёт и копия формы. В форму записываются только полные кварталы." Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap"/></Border>
                        </StackPanel>
                    </Border>
                </Grid>
                <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0" Padding="20,16">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="105"/><ColumnDefinition Width="10"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock x:Name="StatusText" Text="Выберите период и установки" FontWeight="SemiBold"/><ProgressBar x:Name="ProgressBar" Height="7" Maximum="100" Margin="0,9,28,0" Foreground="{StaticResource AccentBrush}" Background="#E9EEF6"/></StackPanel>
                        <Button x:Name="CancelButton" Grid.Column="1" Content="Отменить" IsEnabled="False" Click="CancelButton_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button x:Name="GenerateButton" Grid.Column="3" Content="Сформировать мониторинг" Click="GenerateButton_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
