<Window x:Class="Analizator.DatabaseBackupSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки резервных копий" Icon="Assets/AppIcon.ico"
        Width="560" Height="570" MinWidth="520" MinHeight="540"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Резервные копии базы" FontSize="25" FontWeight="SemiBold" />
            <TextBlock Text="Автоматическое сохранение и подтверждения опасных действий"
                       Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}" Padding="18">
                    <StackPanel>
                        <CheckBox x:Name="AutomaticBackupsCheckBox"
                                  Content="Создавать резервные копии автоматически"
                                  FontWeight="SemiBold" Checked="AutomaticBackups_Changed"
                                  Unchecked="AutomaticBackups_Changed" />
                        <TextBlock Text="Проверка выполняется при запуске программы."
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                   Margin="24,5,0,14" />
                        <Grid x:Name="AutomaticOptionsGrid" Margin="24,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Интервал, дней" FontWeight="SemiBold" Margin="0,0,0,5" />
                                <TextBox x:Name="IntervalDaysTextBox" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Хранить последних копий" FontWeight="SemiBold" Margin="0,0,0,5" />
                                <TextBox x:Name="MaximumFilesTextBox" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Изменение данных" FontSize="16" FontWeight="SemiBold" />
                        <CheckBox x:Name="BackupBeforeChangesCheckBox"
                                  Content="Создавать копию перед изменением или удалением"
                                  Margin="0,13,0,0" />
                        <CheckBox x:Name="ConfirmRowDeletionCheckBox"
                                  Content="Спрашивать подтверждение при удалении строки"
                                  Margin="0,12,0,0" />
                        <CheckBox x:Name="ConfirmSourceDeletionCheckBox"
                                  Content="Спрашивать подтверждение при удалении загруженного файла"
                                  Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock Text="При превышении лимита самые старые копии удаляются автоматически."
                           Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                           TextWrapping="Wrap" Margin="2,12,2,0" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" Width="105" Margin="0,0,10,0" IsCancel="True"
                    Style="{StaticResource SecondaryButtonStyle}" />
            <Button Content="Сохранить" Width="125" IsDefault="True"
                    Click="SaveButton_Click" Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
