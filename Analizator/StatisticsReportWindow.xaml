<Window x:Class="Analizator.StatisticsReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подробная статистика КТК"
        Icon="Assets/AppIcon.ico"
        Width="940" Height="730" MinWidth="820" MinHeight="650"
        WindowStartupLocation="CenterOwner" Closing="Window_Closing">
    <Grid Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="White" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="28,22">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="46" Height="46" CornerRadius="12"
                        Background="#EAF0FF" Margin="0,0,15,0">
                    <TextBlock Text="▥" Foreground="{StaticResource AccentBrush}"
                               FontSize="22" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel>
                    <TextBlock Text="Подробная статистика" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock Text="Фактические показатели по сотрудникам, установкам, сценариям и периодам"
                               Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ReportWorkspace" Margin="24,18,24,24">
                <Border Style="{StaticResource CardStyle}" Padding="20,17">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <StackPanel>
                                <TextBlock Text="Период отчёта" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="По умолчанию выбран весь период локальной базы"
                                           Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                            <Button x:Name="RefreshScopeButton" DockPanel.Dock="Right"
                                    Content="Обновить данные" Width="140"
                                    Click="RefreshScopeButton_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </DockPanel>
                        <Grid Grid.Row="1" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="155" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="155" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Дата начала" Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="11" Margin="0,0,0,4" />
                                <DatePicker x:Name="StartDatePicker" Height="35" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Дата окончания" Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="11" Margin="0,0,0,4" />
                                <DatePicker x:Name="EndDatePicker" Height="35" />
                            </StackPanel>
                            <TextBlock x:Name="ScopeSummaryText" Grid.Column="4"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       VerticalAlignment="Bottom" Margin="0,0,0,9"
                                       TextAlignment="Right" TextWrapping="Wrap" />
                        </Grid>
                    </Grid>
                </Border>

                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="270" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <StackPanel>
                                    <TextBlock Text="Установки" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="В отчёт попадут только отмеченные установки"
                                               Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="SelectAllButton" Content="Все" Width="76" Margin="0,0,8,0"
                                            Click="SelectAllInstallationsButton_Click"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button x:Name="ClearButton" Content="Снять" Width="76"
                                            Click="ClearInstallationsButton_Click"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                </StackPanel>
                            </DockPanel>
                            <ListBox x:Name="InstallationsListBox" Grid.Row="1"
                                     Margin="0,15,0,0" BorderBrush="{StaticResource BorderBrush}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Click="InstallationCheckBox_Click" Margin="8,6">
                                            <Grid Width="440">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding Summary}"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           Margin="12,0,0,0" />
                                            </Grid>
                                        </CheckBox>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <CheckBox x:Name="IncludePossibleDuplicatesCheckBox" Grid.Row="2"
                                      Content="Учитывать возможные повторы" IsChecked="True"
                                      Margin="0,15,0,0" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Состав Excel-отчёта" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Сводка и две диаграммы" Margin="0,15,0,0" />
                            <TextBlock Text="Сотрудники: результаты, активность и стабильность"
                                       Margin="0,8,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="Установки и сценарии" Margin="0,8,0,0" />
                            <TextBlock Text="Помесячная динамика и режимы" Margin="0,8,0,0" />
                            <TextBlock Text="Контроль качества данных" Margin="0,8,0,0" />
                            <TextBlock Text="Полный список исходных записей" Margin="0,8,0,0" />
                            <TextBlock Text="Методика расчёта показателей" Margin="0,8,0,0" />

                            <Border Background="#F7F9FC" CornerRadius="8" Padding="12,10"
                                    Margin="0,18,0,0">
                                <TextBlock Text="Успешность рассчитывается по действующему общему или индивидуальному порогу. Точные повторы исключаются всегда."
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                           TextWrapping="Wrap" />
                            </Border>
                            <CheckBox x:Name="OpenResultCheckBox"
                                      Content="Открыть Excel после создания" IsChecked="True"
                                      Margin="0,18,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0" Padding="20,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="StatusText" Text="Выберите период и установки"
                                       FontWeight="SemiBold" />
                            <ProgressBar x:Name="ProgressBar" Height="7" Maximum="100"
                                         Margin="0,9,28,0" Foreground="{StaticResource AccentBrush}"
                                         Background="#E9EEF6" />
                        </StackPanel>
                        <Button x:Name="CancelButton" Grid.Column="1" Content="Отменить"
                                Width="105" IsEnabled="False" Click="CancelButton_Click"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button x:Name="GenerateButton" Grid.Column="3"
                                Content="Сформировать отчёт" Width="190"
                                Click="GenerateButton_Click"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
